<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:vm="using:Corkboard.ViewModels.SettingsPages"
             xmlns:core="using:Corkboard.Core.Langs.Common"
             xmlns:icons="using:Corkboard.Core.Icons"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="450"
             x:Class="Corkboard.Views.SettingsPages.Account.AccountSettingsPage"
             x:DataType="vm:AccountSettingsPageViewModel">
    <ScrollViewer>
        <StackPanel Classes="page-container">
            <!-- 设置壳不画标题：标题画在 page-container 里，才会和设置卡同宽同左边缘、跟着卡片滚动。 -->
            <TextBlock Margin="0 4 0 0"
                       FontWeight="Normal"
                       Text="{x:Static core:Resources.Settings_Account_Title}"
                       Theme="{StaticResource TitleTextBlockStyle}" />

            <fa:FASettingsExpander Header="{x:Static core:Resources.Settings_Account_Title}"
                                   Description="{x:Static core:Resources.Settings_Account_Description}"
                                   IsExpanded="True">
                <fa:FASettingsExpander.IconSource>
                    <fa:FAFontIconSource Glyph="{x:Static icons:FluentIcons.PersonFilled}"
                                         FontFamily="{DynamicResource FluentSystemIconsResizeable}" />
                </fa:FASettingsExpander.IconSource>
                <fa:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <!-- 登录要跳浏览器、退出要清凭据，两件事都不快，期间给一条滚动进度条并禁用按钮。
                             FluentAvalonia 3.0.2 / Avalonia 12 里没有 ProgressRing 这个控件。 -->
                        <ProgressBar Width="80" Height="4" VerticalAlignment="Center"
                                     IsIndeterminate="True"
                                     IsVisible="{Binding IsBusy}" />
                        <Button Classes="accent"
                                Content="{x:Static core:Resources.Settings_Account_SignIn}"
                                Command="{Binding SignInCommand}"
                                IsEnabled="{Binding !IsBusy}"
                                IsVisible="{Binding !IsSignedIn}" />
                        <!-- 退出会删掉本机保存的凭据，所以先弹确认框（见 code-behind 的 SignOut_OnClick）。 -->
                        <Button Content="{x:Static core:Resources.Settings_Account_SignOut}"
                                Click="SignOut_OnClick"
                                IsEnabled="{Binding !IsBusy}"
                                IsVisible="{Binding IsSignedIn}" />
                    </StackPanel>
                </fa:FASettingsExpander.Footer>

                <!--
                    头像是一个圆：三种状态共用同一个外圈（同一套中性色与描边），只在里面换内容
                    （人形轮廓 / 昵称首字 / 真实头像）。底色走主题资源，深浅色主题下都不会突然多出一个
                    高饱和的圆点。
                -->
                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Account_Profile}"
                                           Description="{x:Static core:Resources.Settings_Account_ProfileDescription}">
                    <fa:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <Border Width="44" Height="44" CornerRadius="22" ClipToBounds="True"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Panel>
                                    <TextBlock Text="{x:Static icons:FluentIcons.PersonFilled}"
                                               FontFamily="{DynamicResource FluentSystemIconsResizeable}"
                                               FontSize="22" Opacity="0.6"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsVisible="{Binding ShowPlaceholder}" />
                                    <TextBlock Text="{Binding Initial}"
                                               FontSize="18" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsVisible="{Binding ShowInitial}" />
                                    <Image Source="{Binding Avatar}"
                                           Stretch="UniformToFill"
                                           IsVisible="{Binding HasAvatar}" />
                                </Panel>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="2" MaxWidth="260">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontWeight="SemiBold" TextWrapping="Wrap"
                                           IsVisible="{Binding IsSignedIn}" />
                                <TextBlock Text="{x:Static core:Resources.Settings_Account_SignedOut}"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding !IsSignedIn}" />
                                <!-- 凭据失效时单独提示一句：这时候界面看着还是登录态，不说明用户会以为坏了。 -->
                                <TextBlock Text="{x:Static core:Resources.Settings_Account_Reauthorize}"
                                           FontSize="12" TextWrapping="Wrap"
                                           IsVisible="{Binding RequiresReauthorization}" />
                            </StackPanel>
                        </StackPanel>
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <!-- 账号 ID 不单列一行：它已经作为显示名的回退出现在上面，重复一次没有信息量。 -->
                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Account_Email}"
                                           IsVisible="{Binding HasEmail}">
                    <fa:FASettingsExpanderItem.Footer>
                        <TextBlock VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding Email}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>

                <!-- 登录要跳到系统浏览器里完成，期间给一句明确的等待提示，别让界面看起来卡住。 -->
                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Account_Waiting}"
                                           Description="{x:Static core:Resources.Settings_Account_WaitingDescription}"
                                           IsVisible="{Binding IsWaitingForBrowser}" />

                <fa:FASettingsExpanderItem Content="{x:Static core:Resources.Settings_Account_Error}"
                                           Description="{x:Static core:Resources.Settings_Account_ErrorDescription}"
                                           IsVisible="{Binding HasError}">
                    <fa:FASettingsExpanderItem.Footer>
                        <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                                   Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                   Text="{Binding ErrorMessage}" />
                    </fa:FASettingsExpanderItem.Footer>
                </fa:FASettingsExpanderItem>
            </fa:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
